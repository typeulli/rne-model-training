# Training output -- every one of these is reproducible from a `train.py` run,
# and the checkpoints alone run to hundreds of MB across a sweep.
runs/
checkpoints/
figures/
*.pt
*.pth
*.ckpt

# Superseded runs, parked rather than deleted. The three patterns above already
# match at any depth, so `legacy/checkpoints/` and friends are covered; this
# catches whatever else gets left in there.
legacy/

# The corpus lives in ../rne-am-simulation/data and is ignored by that repo,
# but guard against a stray copy landing here.
data/
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
